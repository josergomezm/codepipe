# Copy this file to `.env` and fill in your own values.
# The server loads `.env` automatically on startup.

# --- Web Push notifications ---
# Generate a key pair once with: npm run gen-vapid
# Then paste the values below. Without these, push notifications stay disabled
# and the UI hides the "Enable notifications" toggle.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact address embedded in push requests (mailto: or https:). Optional.
VAPID_SUBJECT=mailto:admin@codepipe.local
